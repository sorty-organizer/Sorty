    "\"%@\" matched %lld %@ in %lld %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "\"%1$@\" matched %2$lld %3$@ in %4$lld %5$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" passte %2$lld %3$@ in %4$lld %5$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" coincidió con %2$lld %3$@ en %4$lld %5$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" a correspondu à %2$lld %3$@ dans %4$lld %5$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" は %2$lld %3$@ と一致しました。%4$lld %5$@ です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" 匹配 %2$lld %3$@ 在 %4$lld %5$@ 中。"
          }
        }
      }
    },
