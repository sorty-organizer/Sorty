    "Deny consequences indicate exactly what functionality becomes unavailable when a host is blocked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehne Konsequenzen ab, um genau zu zeigen, welche Funktionen bei einem blockierten Host nicht verfügbar sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los consecuencias de negar indican exactamente qué funcionalidad se vuelve inaccesible cuando un host está bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuser les conséquences indique exactement quelle fonctionnalité devient inaccessibile lorsqu'un hôte est bloqué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否の結果は、ホストがブロッked（制限）されているときにどの機能が利用できないかを正確に示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝后果表示当主机被阻止时，确切的功能将不可用。"
          }
        }
      }
    },
    "Describe files Sorty should never touch, in plain English.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe die Dateien, die Sorty nie berühren sollte, in einfacher Sprache."
          }
        },
        "es": {
