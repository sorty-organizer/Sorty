    "Your %lld manual %@ been recorded. When you apply this organization, %@ will help improve future suggestions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your %1$lld manual %2$@ been recorded. When you apply this organization, %3$@ will help improve future suggestions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre %1$lld Anleitung %2$@ wurde aufgenommen. Wenn Sie diese Organisation anwenden, %3$@ wird helfen, zukünftige Vorschläge zu verbessern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu %1$lld manual %2$@ ha sido registrado. Cuando apliques esta organización, %3$@ ayudará a mejorar las sugerencias futuras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre %1$lld travail manuel %2$@ a été enregistré. Lorsque vous appliquerez cette organisation, %3$@ aidera à améliorer les suggestions futures."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの%1$lld手作業%2$@が記録されました。この整理を適用すると、%3$@は将来的な推奨を改善するのに役立ちます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
