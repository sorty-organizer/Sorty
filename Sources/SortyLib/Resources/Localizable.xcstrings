    "Duplicate scan stats. %lld files scanned. %lld hash candidates. %lld files hashed. %lld cache hits. %lld unreadable files. Duration %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Duplicate scan stats. %1$lld files scanned. %2$lld hash candidates. %3$lld files hashed. %4$lld cache hits. %5$lld unreadable files. Duration %6$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelungsscan-Statistiken. %1$lld Dateien skannen. %2$lld Hash-Kandidaten. %3$lld Dateien gehasht. %4$lld Cache-Hits. %5$lld unlesbar Dateien. Dauer %6$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estadísticas de escaneo de duplicados. %1$lld archivos escaneados. %2$lld candidatos de hash. %3$lld archivos hash. %4$lld aciertos en la cache. %5$lld archivos no legibles. Duración %6$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiques de scan de doublons. %1$lld fichiers scannés. %2$lld candidats de hachage. %3$lld fichiers hachés. %4$lld touches de cache. %5$lld fichiers non lisible. Durée %6$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複スキャン統計。%1$lldファイルがスキャンされました。%2$lldハッシュ候補。%3$lldファイルがハッシュされました。%4$lldキャッシュヒット。%5$lld読み込めないファイル。_duration %6$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复扫描统计。%1$lld文件扫描。%2$lld哈希候选。%3$lld文件哈希。%4$lld缓存命中。%5$lld不可读文件。持续时间%6$@。"
          }
        }
      }
    },
