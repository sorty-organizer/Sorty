    "Set up the folder structure you prefer. New files will then be placed into that structure without rearranging the whole folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle die bevorzugte Ordnerstruktur ein. Neue Dateien werden dann in diese Struktur platziert, ohne die gesamte Ordnerstruktur umzubauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura la estructura de carpetas que prefieras. Los nuevos archivos se colocarán en esa estructura sin reorganizar toda la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez la structure de dossier que vous préférez. Les nouveaux fichiers seront alors placés dans cette structure sans réorganiser l'ensemble du dossier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お好みのフォルダ構造を設定してください。新しいファイルはその構造に自動的に配置され、全体のフォルダを再配置することなく置かれます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置您偏好的文件夹结构。新文件将被放置到该结构中，而不会重新排列整个文件夹。"
          }
        }
      }
    },
