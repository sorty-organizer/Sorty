          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty 当前没有可用的实验性功能。"
          }
        }
      }
    },
    "Sorty is analyzing your workflow description...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty analysiert deine Workflow-Beschreibung..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty está analizando tu descripción de trabajo..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty analyse votre description de workflow..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty はあなたのワークフローの説明を分析しています..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty 正在分析您的工作流程描述..."
          }
        }
      }
    },
    "Sorty is ready to %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty ist bereit für %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty está listo para %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty est prêt à %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty は %1$@ に準備しています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty 准备好 %1$@"
          }
        }
      }
    },
    "Sorty masks username path segments in streamed text, but model-generated names can still appear before full parsing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty verbirgt Benutzernamen in den Pfadsegments bei gestreamten Texten, aber Modellgenerierte Namen können sich noch vor der vollständigen Verarbeitung zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty enmascara los segmentos de nombre de usuario en texto en tiempo real, pero los nombres generados por modelos aún pueden aparecer antes de la completa parseo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty masque les segments de chemin d'utilisateur dans le texte en flux, mais les noms générés par le modèle peuvent encore apparaître avant la parse complète."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty はストリームされたテキストでユーザー名のパスセグメントをマスキングしますが、モデル生成の名前はまだ完全な解析前に表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty 隐藏流文本中的用户名路径段，但模型生成的名称仍可能在完全解析前出现."
          }
        }
      }
    },
    "Sorty needs Files & Folders access before organizing. Grant optional permissions now if you want Finder actions, broader folder access, or system notifications.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty benötigt vor der Organisation Zugriff auf Files & Folders. Erlaube optional die Berechtigungen jetzt, wenn du Finder-Aktionen, umfassenderes Ordnerzugriff oder Systembenachrichtigungen wünschst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty necesita acceso a Archivos y Carpeta antes de organizar. Grante permisos opcionales ahora si quieres acciones de Finder, acceso más amplio a carpetas o notificaciones del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty a besoin d'accès à « Fichiers et Dossiers » avant d'organiser. Accordez les permissions optionnelles maintenant si vous souhaitez des actions de Finder, un accès plus large aux dossiers ou des notifications système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty はファイルとフォルダへのアクセスが必要です。Finderのアクション、広いフォルダへのアクセス、システム通知を希望する場合は、現在のアクセスを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty 在组织文件前需要 Files & Folders 访问权限。如果您想使用 Finder 功能、更广泛的文件夹访问或系统通知，请现在授予可选权限."
          }
        }
      }
    },
    "Sorty needs more detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty benötigt mehr Details"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty necesita más detalles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty a besoin de plus de détails"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty にはより詳細が必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty 需要更多详细信息"
          }
        }
      }
    },
    "Sorty repairs the Finder menu action automatically where macOS allows it. Use these only if Finder still does not show Sorty actions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty repariert den Finder-Menüaktion automatisch, wo macOS dies erlaubt. Nutze diese nur, wenn Finder immer noch Sorty-Aktionen nicht anzeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty corrige automáticamente la acción del menú de Finder donde macOS lo permite. Usa estas solo si Finder aún no muestra acciones de Sorty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty répare automatiquement l'action du menu Finder. Utilisez ces options uniquement si Finder ne montre toujours pas les actions de Sorty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty はmacOSが許可する範囲内でFinderメニューのアクションを自動的に修正します。FinderがまだSortyのアクションを表示しない場合は、これらのアクションを使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty 会自动修复 Finder 菜单操作，只要 macOS 允许。仅在 Finder 仍不显示 Sorty 操作时使用这些功能."
          }
        }
      }
    },
    "Sorty sends file names and metadata to the provider you pick. File contents stay on your Mac unless you enable Deep Scan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty sendet Dateinamen und Metadaten an den ausgewählten Anbieter. Die Dateiinhalt bleibt auf deinem Mac, es sei denn du aktivierst Deep Scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty envía los nombres de archivos y metadatos al proveedor que elijas. El contenido de los archivos permanece en tu Mac a menos que habilites el Escaneo Profundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty envoie les noms de fichiers et les métadonnées vers le fournisseur que vous avez choisi. Les contenus des fichiers restent sur votre Mac à moins d'activer la recherche approfondie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty は選んだプロバイダーにファイル名とメタデータを送信します。ファイルのコンテンツはMacに残っています。Deep Scanを有効にしない限りです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty 会将文件名和元数据发送到您选择的提供者。除非启用了 Deep Scan，文件内容仍保留在您的 Mac 上."
          }
        }
      }
    },
    "Sorty will stop learning from your organization activity. Your existing learning data and preferences will stay saved, and you can turn learning back on at any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty wird die Lernung aus deiner Organisation-Aktivität stoppen. Deine bestehenden Lern-Daten und Vorlieben werden gespeichert bleiben, und du kannst die Lernung jederzeit wieder einschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty dejará de aprender de tu actividad de organización. Tus datos de aprendizaje existentes y preferencias se guardarán, y podrás volver a habilitar el aprendizaje en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty arrêtera d'apprendre à partir de votre activité d'organisation. Vos données d'apprentissage existantes et vos préférences seront conservées, et vous pouvez reprendre l'apprentissage à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty はあなたの整理活動から学習を停止します。既存の学習データと設定は保存され、いつでも学習を再開できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty 将停止从您的组织活动学习。您的现有学习数据和偏好将保留，您随时可以重新开启学习功能."
          }
        }
      }
    },
    "Sorty will use this custom workflow by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty wird diesen benutzerdefinierten Workflow standardmäßig verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty utilizará este flujo de trabajo personalizado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty utilisera ce workflow personnalisé par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty はこのカスタムワークフローをデフォルトで使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty 会默认使用此自定义工作流."
          }
        }
      }
    },
