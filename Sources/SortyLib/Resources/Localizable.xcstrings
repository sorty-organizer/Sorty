          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprimera définitivement tous vos données d'apprentissage et vos préférences. Cela ne peut pas être annulé."
          }
        },
        "ja": {
          "stringUnit": {
