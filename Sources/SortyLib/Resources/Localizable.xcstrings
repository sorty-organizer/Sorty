    "Sorty generates multiple options for you to choose": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty generiert mehrere Optionen für dich zur Auswahl"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty genera varias opciones para que las elijas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty génère plusieurs options pour que vous les choisissiez"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorty はいくつかのオプションを生成します。あなたが選ぶことができます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
