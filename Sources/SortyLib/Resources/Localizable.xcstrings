    },
    "This will stop Sorty's analysis and return to the start screen. Your progress will not be saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies beendet Sortys Analyse und bringt dich zur Startseite. Deine Fortschritte werden nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este detendrá el análisis de Sorty y volverás a la pantalla de inicio. Tu progreso no se guardará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action arrêtera l'analyse de Sorty et vous renverra à l'écran d'accueil. Votre progression ne sera pas sauvegardée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作はSortyの分析を停止し、スタートスクリーンに戻します。進捗は保存されません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将停止Sorty的分析，并返回到起始屏幕。您的进度将不会被保存。"
          }
        }
      }
    },
    "This will undo all organization sessions after this point for this folder. Some files may have been modified or moved since.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies rückgängig macht alle Organisationssitzungen nach diesem Punkt für diesen Ordner. Einige Dateien wurden möglicherweise geändert oder verschoben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este anulará todas las sesiones de organización después de este punto para esta carpeta. Algunos archivos pueden haberse modificado o movido desde entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action annulerá toutes les sessions d'organisation après ce point pour ce dossier. Certains fichiers ont pu être modifiés ou déplacés depuis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は、このフォルダのこのポイント以降のすべての組織セッションを取り消します。一部のファイルが変更または移動されている可能性があります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将撤销此文件夹中此点之后的所有组织会话。一些文件可能在此期间被修改或移动。"
          }
        }
      }
    },
    "This will undo all organizations performed after this snapshot. Files will be moved back to their original locations found in this snapshot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies rückt alle Organisationen rückgängig, die nach diesem Screenshot durchgeführt wurden. Die Dateien werden in ihre ursprünglichen Orte zurückgebracht, die in diesem Screenshot gefunden wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este anulará todas las organizaciones realizadas después de este snapshot. Los archivos se moverán de vuelta a sus ubicaciones originales encontradas en este snapshot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action annulera toutes les organisations effectuées après ce point. Les fichiers seront déplacés vers leurs emplacements d'origine trouvés dans ce point d'inspection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は、このスナップショット以降に行われたすべての組織を取り消します。ファイルはこのスナップショットで見つけたオリジナルの場所に戻ります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将撤销此快照之后的所有组织操作。文件将被移动回此快照中发现的原始位置。"
          }
        }
      }
    },
