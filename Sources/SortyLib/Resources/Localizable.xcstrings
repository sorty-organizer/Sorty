          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审查组别"
          }
        }
      }
    },
    "Review past runs, undo changes, and reapply plans when needed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergangene Laufzeiten überprüfen, Änderungen rückgängig machen und Pläne bei Bedarf erneut anwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar ejecuciones anteriores, deshacer cambios y reaplicar planes cuando sea necesario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier les exécutions passées, annuler les modifications et reappliquer les plans lorsqu'il est nécessaire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の実行を確認し、変更をやり直し、必要に応じて計画を再適用してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审查之前的运行，撤销更改，并在需要时重新应用计划"
          }
        }
      }
    },
    "Review the generated persona, then use it as your default workflow for Sorty.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie das generierte Profil, dann verwenden Sie es als Standardworkflow für Sorty."
          }
        },
        "es": {
