    "%@\n\nEdit the instructions above, then click Improve again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nBearbeite die Anweisungen oben, dann klicke erneut auf Verbessern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nEdite las instrucciones anteriores, luego haga clic en Mejorar nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nModifiez les instructions ci-dessus, puis cliquez à nouveau sur Améliorer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n上記の指示を編集し、再度「改善」をクリックしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n编辑上面的指令，然后再次点击改进。"
          }
        }
      }
    },
