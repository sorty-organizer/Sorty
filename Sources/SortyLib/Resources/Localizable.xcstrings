    },
    "This organization included moves to external storage locations": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Organisation umfasst Verschiebungen in externe Speicherort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este organización incluyó movimientos a ubicaciones de almacenamiento externo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette organisation inclut des déplacements vers des emplacements de stockage externes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この組織には外部ストレージへの移動が含まれています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
