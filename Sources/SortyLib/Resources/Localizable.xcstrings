    "Review exact duplicates first. Similarity matches stay separate and need individual confirmation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie zuerst die genauen Duplikate. Ähnliche Übereinstimmungen bleiben getrennt und benötigen eine individuelle Bestätigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar duplicados exactos primero. Los coincidencias de similitud permanecen separados y necesitan confirmación individual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez d'abord les doublons exacts. Les correspondances similaires restent séparées et nécessitent une confirmation individuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正確な重複を最初に確認してください。類似のマッチは別々に残され、個別に確認が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先审查精确重复项。相似性匹配保持独立，需要单独确认。"
          }
        }
      }
    },
    "Review groups": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen überprüfen"
          }
        },
        "es": {
