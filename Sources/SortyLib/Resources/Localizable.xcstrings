        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez ici vos préférences permanentes, notamment le nombre de dossiers ou la hiérarchie. Sorty les enregistre avec cette persona."
          }
        },
        "ja": {
          "stringUnit": {
